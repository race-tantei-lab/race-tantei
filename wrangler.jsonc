{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "race-tantei-phase0",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "account_id": "3c6d1826b573b2e68cb13ec37e9e8ade",
  "workers_dev": true,
  "vars": {
    "ENVIRONMENT": "phase0",
    "PROBE_ENABLED": "true",
    "PHASE0_MAX_CRON_SUCCESSES": "3",
    "PHASE0_MAX_CRON_ATTEMPTS": "12",
    "JRA_ROBOTS_PROBE_URL": "https://www.jra.go.jp/robots.txt",
    "JRA_RESULT_PROBE_URL": "https://sp.jra.jp/JRADB/accessS.html?CNAME=sw01sde0101202601030520260801%2FD1",
    "JRA_ENTRY_PROBE_URL": "https://sp.jra.jp/JRADB/accessD.html?CNAME=sw01dde0101202601030520260801%2F15"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "race-tantei-phase0",
      "database_id": "949b5e8b-d1a4-4c4e-80d1-d031afdc03de",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["17 * * * *"]
  }
}
