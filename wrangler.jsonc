{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "race-tantei-phase0",
  "main": "src/public-site-entry-v33.ts",
  "compatibility_date": "2026-08-01",
  "account_id": "3c6d1826b573b2e68cb13ec37e9e8ade",
  "workers_dev": true,
  "build": {
    "command": "test -f worker-assets/_internal/completed-model/model.bin || (python -m pip install --disable-pip-version-check 'lightgbm==4.6.0' 'numpy<3' && python scripts/build-worker-completed-model-assets.py)"
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "assets": {
    "directory": "./worker-assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "ENVIRONMENT": "production",
    "DEPLOY_REVISION": "ten-year-completed-public-v33-derived-entry-repair-20260821",
    "MODEL_VERSION": "ten-year-completed-model",
    "JRA_HOME_URL": "https://www.jra.go.jp/",
    "JRA_SEED_ENTRY_URLS": "https://sp.jra.jp/JRADB/accessD.html?CNAME=sw01dde0101202601030520260801%2F15",
    "MIN_EXPECTED_VALUE": "108",
    "MAX_RACE_BUDGET_YEN": "10000",
    "SYNC_BATCH_SIZE": "12"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "race-tantei-phase0",
      "database_id": "949b5e8b-d1a4-4c4e-80d1-d031afdc03de"
    }
  ]
}
